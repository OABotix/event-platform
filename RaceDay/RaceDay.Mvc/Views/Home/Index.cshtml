@{
    ViewData["Title"] = "Home Page";
}

<section class="py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-6">
            <span class="badge bg-warning text-dark mb-3 px-3 py-2">#RaceDay2026</span>
            <h1 class="display-4 fw-bold mb-3">Find your next race.<br />Chase your personal best.</h1>
            <p class="lead text-muted mb-4">
                Discover runs, walks, cycles, swims and triathlons across South Africa — all in one place.
            </p>
            <a asp-controller="Auth" asp-action="RegisterParticipant" class="btn btn-success btn-lg me-2 px-4">
                Join as Participant
            </a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">
                Log in
            </a>
        </div>
        <div class="col-lg-6 text-center">
            <div class="card p-5 border-0" style="background: var(--rd-green-soft);">
                <div class="display-1 mb-3">🏁</div>
                <h4 class="fw-bold">Event Organisers</h4>
                <p class="text-muted">Publish events, manage categories and capture results in one dashboard.</p>
                <a asp-controller="Auth" asp-action="RegisterOrganiser" class="btn btn-outline-success">
                    Start Organising →
                </a>
            </div>
        </div>
    </div>
</section>