@model List<RaceDay.Contracts.Dtos.Results.ResultDto>
    @{ ViewData["Title"] = "My Results"; }

    <div class="container mt-4">
        <h1>My Race Results</h1>

        @if (!Model.Any())
    {
        <p class="text-muted">No results yet. Results appear here after organisers publish them.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr><th>Event</th><th>Date</th><th>Category</th><th>Finish Time</th><th>Position</th></tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                <tr>
                    <td>@r.EventName</td>
                    <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@r.CategoryName</td>
                    <td>@r.FinishTime</td>
                    <td>@r.FinishPosition</td>
                </tr>
                }
            </tbody>
        </table>
    }
    </div>
