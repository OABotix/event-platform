@model RaceDay.Contracts.Dtos.Events.EventDto
@{
    ViewData["Title"] = Model.EventName;
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <a asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">← Back to Events</a>

    <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                <h1 class="mb-0">@Model.EventName</h1>
                <span class="badge bg-warning text-dark px-3 py-2">@Model.EventTypeName</span>
            </div>
            <p class="text-muted">@Model.Description</p>
            <div class="row g-3 mt-2">
                <div class="col-sm-4"><strong>📅 Date:</strong><br />@Model.EventDate.ToString("dd MMM yyyy HH:mm")</div>
                <div class="col-sm-4"><strong>📍 Location:</strong><br />@Model.Location</div>
                <div class="col-sm-4"><strong>🏃 Distance:</strong><br />@Model.Distance km</div>
            </div>
        </div>
    </div>

    <h3 class="mt-4 mb-3">Available Categories</h3>
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr><th>Category</th><th>Description</th><th>Fee</th><th class="text-end">Action</th></tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.Categories)
                {
                    <tr>
                        <td class="fw-semibold">@cat.CategoryName</td>
                        <td class="text-muted small">@cat.Description</td>
                        <td><span class="badge bg-rd-green-soft text-rd-green">R @cat.EntryFee</span></td>
                        <td class="text-end">
                            <form asp-action="EnterEvent" method="post" class="d-inline">
                                <input type="hidden" name="eventId" value="@Model.EventId" />
                                <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                <button type="submit" class="btn btn-sm btn-success">Enter Event</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>