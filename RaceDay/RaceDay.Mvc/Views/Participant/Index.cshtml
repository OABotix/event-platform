@model List<RaceDay.Contracts.Dtos.Events.EventDto>
@{ ViewData["Title"] = "Upcoming Events"; }

<div class="container mt-4">
    <h1>Upcoming Events</h1>
    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <select name="type" class="form-select">
                <option value="">All Types</option>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-md-6">
            <input name="search" class="form-control" placeholder="Search by name or location" value="@ViewBag.SearchFilter" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <div class="row">
        @foreach (var ev in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@ev.EventName</h5>
                        <p class="card-text">@ev.Description</p>
                        <p class="text-muted small">
                            @ev.EventDate.ToString("dd MMM yyyy") • @ev.Location • @ev.Distance km • @ev.EventTypeName
                        </p>
                        <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-primary">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>