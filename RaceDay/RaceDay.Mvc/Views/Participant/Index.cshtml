@model List<RaceDay.Contracts.Dtos.Events.EventDto>
@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <h1 class="mb-0">Upcoming Events</h1>
        <span class="badge bg-warning text-dark px-3 py-2">@Model.Count events</span>
    </div>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <select name="type" class="form-select">
                <option value="">All Types</option>
                <option value="Run">Run</option>
                <option value="Walk">Walk</option>
                <option value="Cycle">Cycle</option>
            </select>
        </div>
        <div class="col-md-6">
            <input name="search" class="form-control" placeholder="Search by name or location" value="@ViewBag.SearchFilter" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-success w-100">Filter</button>
        </div>
    </form>

    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@ev.EventName</h5>
                            <span class="badge bg-secondary">@ev.EventTypeName</span>
                        </div>
                        <p class="card-text small text-muted flex-grow-1">@ev.Description</p>
                        <ul class="list-unstyled small mb-3">
                            <li class="mb-1">📅 <strong>@ev.EventDate.ToString("dd MMM yyyy")</strong></li>
                            <li class="mb-1">📍 @ev.Location</li>
                            <li>🏃 @ev.Distance km</li>
                        </ul>
                        <a asp-action="Details" asp-route-id="@ev.EventId" class="btn btn-success">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>