@model List<RaceDay.Contracts.Dtos.Enrolments.EnrolmentDto>
    @{ ViewData["Title"] = "My Events"; }

    <div class="container mt-4">
        @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
        <h1>My Enrolled Events</h1>

        <table class="table table-striped">
            <thead>
                <tr><th>Event</th><th>Category</th><th>Enrolled</th><th>Status</th></tr>
            </thead>
            <tbody>
                @foreach (var e in Model)
            {
                <tr>
                    <td>@e.EventName</td>
                    <td>@e.CategoryName</td>
                    <td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td>
                        @if (e.Status == "Confirmed") { <span class="badge bg-success">Confirmed</span> }
                        else if (e.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                        else { <span class="badge bg-secondary">@e.Status</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
