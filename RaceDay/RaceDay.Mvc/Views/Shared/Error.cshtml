@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 560px;">
        <div class="card-body p-5">
            <div class="display-4 text-danger mb-2">⚠️</div>
            <h1 class="text-danger mb-2">Something went wrong</h1>
            <p class="text-muted">An error occurred while processing your request.</p>

            @if (Model.ShowRequestId)
            {
                <p class="small text-muted mb-0">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <a asp-controller="Home" asp-action="Index" class="btn btn-success mt-4 px-4">Back to Home</a>
        </div>
    </div>
</div>