@model List<RaceDay.Contracts.Dtos.Events.EventDto>
    @{ ViewData["Title"] = "My Events"; }

    <div class="container mt-4">
        <h1>My Events</h1>
        <a asp-action="CreateEvent" class="btn btn-success mb-3">Create New Event</a>

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Distance</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
            {
                <tr>
                    <td>@ev.EventName</td>
                    <td>@ev.EventDate.ToString("dd MMM yyyy")</td>
                    <td>@ev.Location</td>
                    <td>@ev.Distance km</td>
                    <td>
                        <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this event?')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
