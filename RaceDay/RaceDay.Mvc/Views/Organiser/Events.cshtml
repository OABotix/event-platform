@model List<RaceDay.Contracts.Dtos.Events.EventDto>
@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h1 class="mb-0">My Events</h1>
        <a asp-action="CreateEvent" class="btn btn-success px-4">+ Create New Event</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr><th>Name</th><th>Date</th><th>Location</th><th>Distance</th><th>Banner</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="fw-semibold">@ev.EventName</td>
                        <td class="text-muted">@ev.EventDate.ToString("dd MMM yyyy")</td>
                        <td>@ev.Location</td>
                        <td>@ev.Distance km</td>
                        <td>
                            @if (!string.IsNullOrEmpty(ev.BannerImageUrl))
                            {
                                <img src="@ev.BannerImageUrl" alt="Banner" style="max-height: 50px; border-radius: 8px;" />
                            }
                            else
                            {
                                <span class="text-muted small">No image</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditEvent" asp-route-id="@ev.EventId" class="btn btn-sm btn-warning">Edit</a>
                            <form asp-action="DeleteEvent" asp-route-id="@ev.EventId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this event?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>