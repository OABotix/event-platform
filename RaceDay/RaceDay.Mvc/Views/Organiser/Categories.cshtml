@model List<RaceDay.Contracts.Dtos.Categories.CategoryDto>
    @{ ViewData["Title"] = "Categories"; int eventId = ViewBag.EventId; }

    <div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

        <h1>Event Categories</h1>

        <table class="table table-striped mb-4">
            <thead>
                <tr><th>Name</th><th>Description</th><th>Fee</th></tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CategoryName</td>
                    <td>@c.Description</td>
                    <td>R @c.EntryFee</td>
                </tr>
            }
            </tbody>
        </table>

        <h3>Add Category</h3>
        <form asp-action="AddCategory" asp-route-eventId="@eventId" method="post">
            <div class="row">
                <div class="col-md-4">
                    <input name="CategoryName" class="form-control mb-2" placeholder="Category Name" required />
                </div>
                <div class="col-md-4">
                    <input name="Description" class="form-control mb-2" placeholder="Description" />
                </div>
                <div class="col-md-2">
                    <input name="EntryFee" type="number" step="0.01" class="form-control mb-2" placeholder="Fee" required />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success">Add</button>
                </div>
            </div>
        </form>
    </div>
