@model RaceDay.Contracts.Dtos.Events.CreateEventRequest
@{
    ViewData["Title"] = "Create Event";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <h1 class="mb-4">Create Event</h1>
                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Event Name</label>
                                <input asp-for="EventName" class="form-control" required />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Event Type</label>
                                <select asp-for="EventTypeId" class="form-select">
                                    <option value="1">Run</option>
                                    <option value="2">Walk</option>
                                    <option value="3">Cycle</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea asp-for="Description" class="form-control" rows="3" required></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Event Date</label>
                                <input asp-for="EventDate" type="datetime-local" class="form-control" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Distance (km)</label>
                                <input asp-for="Distance" type="number" step="0.01" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Location</label>
                                <input asp-for="Location" class="form-control" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Event Banner Image</label>
                                <input type="file" name="banner" class="form-control" accept="image/*" />
                            </div>
                        </div>
                        <div class="mt-4 d-flex gap-2">
                            <button type="submit" class="btn btn-success px-4">Create Event</button>
                            <a asp-action="Events" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>